---
import '../styles/global.css';
import { dirOf, t, type Lang } from '../i18n/ui';
const { lang = 'en' as Lang, title, description = '', path = '' } = Astro.props;
const dir = dirOf(lang);
const other = lang === 'en' ? 'ar' : 'en';
const nav = [
  { href: `/${lang}/about/`,    key: 'about' as const },
  { href: `/${lang}/series/`,   key: 'series' as const },
  { href: `/${lang}/parents/`,  key: 'parents' as const },
  { href: `/${lang}/schools/`,  key: 'schoolsShort' as const }
];
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="alternate" hreflang="en" href={`https://libooks.ae/en/${path}`} />
<link rel="alternate" hreflang="ar" href={`https://libooks.ae/ar/${path}`} />
<link rel="alternate" hreflang="x-default" href={`https://libooks.ae/en/${path}`} />
<link rel="canonical" href={`https://libooks.ae/${lang}/${path}`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
<header class="top">
  <div class="wrap tin">
    <a class="brand" href={`/${lang}/`} aria-label="Live Informatics Publishing">
      <img class="logo" src="/assets/logo.svg" alt="Live Informatics Publishing"
           onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
      <span class="fb"><i></i>Live Informatics</span>
    </a>
    <nav class="mn">
      {nav.map(n => <a href={n.href} class={n.key === 'series' ? 'keep' : ''}>{t(lang, n.key)}</a>)}
      <a class="lang" href={`/${other}/${path}`}>
        <span>{other === 'ar' ? 'العربية' : 'English'}</span><span class="ar-i">→</span>
      </a>
    </nav>
  </div>
</header>

<main><slot /></main>

<footer>
  <div class="wrap">
    <div class="fg">
      <div><h5>{t(lang,'about')}</h5><ul>
        <li><a href={`/${lang}/about/`}>{t(lang,'about')}</a></li>
        <li><a href={`/${lang}/news/`}>{t(lang,'news')}</a></li>
        <li><a href={`/${lang}/contact/`}>{t(lang,'contact')}</a></li>
      </ul></div>
      <div><h5>{t(lang,'series')}</h5><ul>
        <li><a href={`/${lang}/series/manara/`}>Manara · منارة</a></li>
        <li><a href={`/${lang}/series/isharat/`}>Isharat · إشارات</a></li>
        <li><a href={`/${lang}/series/qalam/`}>Qalam · قلم</a></li>
      </ul></div>
      <div><h5>{t(lang,'parents')}</h5><ul>
        <li><a href={`/${lang}/parents/tips/`}>{t(lang,'tips')}</a></li>
        <li><a href={`/${lang}/parents/materials/`}>{t(lang,'extras')}</a></li>
      </ul></div>
      <div><h5>{t(lang,'schoolsShort')}</h5><ul>
        <li><a href={`/${lang}/schools/teaching/`}>{t(lang,'teaching')}</a></li>
        <li><a href={`/${lang}/schools/methodology/`}>{t(lang,'methodology')}</a></li>
      </ul></div>
    </div>
    <div class="lg"><span>Live Informatics Publishing FZE</span><span>UAE</span><span>libooks.ae</span></div>
  </div>
</footer>
</body>
</html>
