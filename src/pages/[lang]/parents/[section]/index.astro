---
import Base from '../../../../layouts/Base.astro';
import SectionList from '../../../../components/SectionList.astro';
import { t, langs, type Lang } from '../../../../i18n/ui';
import { SECTION_MAP } from '../../../../lib/sections';

export function getStaticPaths(){
  const out: any[] = [];
  for (const lang of langs) for (const section of Object.keys(SECTION_MAP['parents']))
    out.push({ params:{ lang, section } });
  return out;
}
const lang = Astro.params.lang as Lang;
const section = Astro.params.section as string;
const m = SECTION_MAP['parents'][section];
---
<Base lang={lang} title={`${t(lang, m.key)} — Live Informatics Publishing`} path={`parents/${section}/`}>
  <SectionList lang={lang} audience="parents" path={section} sec={m.sec} key={m.key} />
</Base>
