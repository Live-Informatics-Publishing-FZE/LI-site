---
import Base from '../../../layouts/Base.astro';
import { t, langs, fdate, type Lang } from '../../../i18n/ui';
import { getNews } from '../../../lib/data';
export function getStaticPaths(){ return langs.map(lang => ({ params:{ lang } })); }
const lang = Astro.params.lang as Lang;
const news = await getNews(lang);
---
<Base lang={lang} title={`${t(lang,'news')} — Live Informatics Publishing`} path="news/">
  <div class="wrap"><div class="crumb">
    <a href={`/${lang}/about/`}>{t(lang,'about')}</a><span class="sp">/</span><span>{t(lang,'news')}</span></div></div>
  <section style="padding-block:clamp(1.5rem,4vw,2.6rem)"><div class="wrap">
    <p class="lbl">{t(lang,'news')}</p>
    <h1 style="font-size:var(--s-3);margin-block-start:.5rem">{lang==='en'?'All news':'كل الأخبار'}</h1>
  </div></section>
  <section class="band"><div class="wrap"><div class="mos">
    {news.map((n,i) => <a class={`ncard ${i===0?'big':''}`} href={n.data.link || '#'}>
      <span class="lbl">{fdate(n.data.date)}</span><h4>{n.data.title}</h4><p>{(n.data as any).body}</p></a>)}
  </div></div></section>
</Base>
