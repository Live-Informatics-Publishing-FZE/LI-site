---
import Base from '../../layouts/Base.astro';
import OrgCard from '../../components/OrgCard.astro';
import DocLinks from '../../components/DocLinks.astro';
import { t, langs, type Lang } from '../../i18n/ui';
import { org } from '../../lib/org';
export function getStaticPaths(){ return langs.map(lang => ({ params:{ lang } })); }
const lang = Astro.params.lang as Lang;
const lede = lang==='en'
  ? 'Schools, learning centres and families — every message is answered.'
  : 'للمدارس ومراكز التعلّم والأسر: نردّ على كل رسالة.';
---
<Base lang={lang} title={`${t(lang,'contact')} — Live Informatics Publishing`} description={lede} path="contact/">
  <div class="wrap"><div class="crumb">
    <a href={`/${lang}/about/`}>{t(lang,'about')}</a><span class="sp">/</span><span>{t(lang,'contact')}</span></div></div>
  <section style="padding-block:clamp(1.5rem,4vw,2.6rem)"><div class="wrap">
    <p class="lbl">{org.legal_name}</p>
    <h1 style="font-size:var(--s-3);margin-block-start:.5rem">{t(lang,'contact')}</h1>
    <p class="ab-lede" style="color:var(--slate);font-size:var(--s-1);margin-block-start:.9rem;max-inline-size:46ch">{lede}</p>
  </div></section>
  <section class="band"><div class="wrap">
    <div class="cgrid">
      <div class="cbox"><p class="lbl">Email</p><a class="mono" href={`mailto:${org.email}`}>{org.email}</a></div>
      <div class="cbox"><p class="lbl">{t(lang,'phone')}</p><a class="mono" href={`tel:${String(org.phone).replace(/\s/g,'')}`}>{org.phone}</a></div>
      <div class="cbox"><p class="lbl">{t(lang,'address')}</p><span class="v" style="font-size:var(--s-0);font-weight:400">{org.address}</span></div>
      {org.hours
        ? <div class="cbox"><p class="lbl">{t(lang,'hours')}</p><span class="v">{org.hours}</span></div>
        : <div class="cbox" style="border-style:dashed;background:none"><p class="lbl">{t(lang,'hours')}</p><span class="v" style="color:var(--slate);font-weight:400">[ — ]</span></div>}
    </div>
    <div class="acts" style="margin-block-start:2rem">
      <a class="btn" href={`mailto:${org.email}`}>{t(lang,'requestSchool')}</a>
      <a class="btn g" href={`mailto:${org.email}`}>{t(lang,'enquiry')}</a>
    </div>
  </div></section>
  <section class="band"><div class="wrap">
    <div class="bh"><div><p class="lbl">{t(lang,'officialInfo')}</p><h2 style="font-size:var(--s-2)">{t(lang,'publisher')}</h2></div></div>
    <OrgCard lang={lang} /><DocLinks lang={lang} />
  </div></section>
</Base>
