---
import Base from '../../../layouts/Base.astro';
import AudienceIndex from '../../../components/AudienceIndex.astro';
import { t, langs, type Lang } from '../../../i18n/ui';
export function getStaticPaths(){ return langs.map(lang => ({ params:{ lang } })); }
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={`${t(lang,'schools')} — Live Informatics Publishing`} path="schools/">
  <AudienceIndex lang={lang} audience="schools" />
</Base>
