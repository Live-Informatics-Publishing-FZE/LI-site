---
import { t, fdate, type Lang } from '../i18n/ui';
import { getArticles } from '../lib/data';
const { lang, audience, path, sec, key } = Astro.props;
const items = await getArticles(lang, sec);
---
<div class="wrap"><div class="crumb">
  <a href={`/${lang}/${audience}/`}>{t(lang, audience==='parents'?'parents':'schools')}</a>
  <span class="sp">/</span><span>{t(lang, key)}</span></div></div>
<section style="padding-block:clamp(1.5rem,4vw,2.6rem)"><div class="wrap">
  <p class="lbl">{t(lang, audience==='parents'?'parents':'schools')}</p>
  <h1 style="font-size:var(--s-3);margin-block-start:.5rem">{t(lang, key)}</h1>
</div></section>
<section class="band"><div class="wrap"><div class="alist">
  {items.map(a => <a class="ncard" href={`/${lang}/${audience}/${path}/${a.slug}/`}>
    <span class="lbl">{fdate(a.data.date)}</span><h4>{a.data.title}</h4><p>{a.data.seo_description}</p></a>)}
  <div class="ncard" style="border-style:dashed;background:none">
    <span class="lbl">{lang==='en'?'Next':'التالي'}</span>
    <p>{lang==='en'?'Roughly one new article a month. This slot is where it lands.':'مقال جديد كل شهر تقريبًا.'}</p>
  </div>
</div></div></section>
