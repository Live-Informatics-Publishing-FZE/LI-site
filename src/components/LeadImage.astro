---
/** Одно изображение к материалу. Пока фотографий нет — фирменная заставка,
 *  детерминированная по названию, чтобы у каждой статьи она была своя. */
const { src = '', alt = '', seed = '', ratio = '16/9' } = Astro.props;
let h = 0; for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const v = h % 3;
---
<figure class="lead" style={`--ar:${ratio}`}>
  {src ? (
    <img src={src} alt={alt} />
  ) : (
    <div class="figbox" style={`aspect-ratio:${ratio}`}>
      <svg viewBox="0 0 200 112" fill="none" aria-hidden="true">
        {v === 0 && <>
          <g stroke="#BEA05A" stroke-width="2.5" stroke-linecap="round"><path d="M30 40h48M30 56h76M30 72h34"/></g>
          <g stroke="#F3F5F8" stroke-width="2.5" stroke-linecap="round" opacity=".5"><path d="M92 72h28M120 56h34"/></g>
          <circle cx="150" cy="80" r="9" stroke="#BEA05A" stroke-width="2.5"/>
        </>}
        {v === 1 && <>
          <g stroke="#F3F5F8" stroke-width="1.5" opacity=".28"><path d="M0 32h200M0 60h200M0 88h200"/></g>
          <rect x="24" y="20" width="30" height="20" rx="3" fill="#BEA05A"/>
          <rect x="80" y="48" width="30" height="20" rx="3" fill="#BEA05A" opacity=".7"/>
          <rect x="136" y="76" width="30" height="20" rx="3" fill="#BEA05A" opacity=".45"/>
          <g stroke="#F3F5F8" stroke-width="2" stroke-linecap="round" opacity=".55"><path d="M54 30h26v18M110 58h26v18"/></g>
        </>}
        {v === 2 && <>
          <rect x="26" y="22" width="148" height="68" rx="5" stroke="#F3F5F8" stroke-width="1.5" opacity=".35"/>
          <g fill="#BEA05A"><circle cx="58" cy="56" r="6"/><circle cx="84" cy="56" r="6" opacity=".72"/><circle cx="110" cy="56" r="6" opacity=".48"/><circle cx="136" cy="56" r="6" opacity=".26"/></g>
          <path d="M58 56h78" stroke="#BEA05A" stroke-width="1.5" opacity=".4"/>
        </>}
      </svg>
      <span class="cap">IMAGE SLOT</span>
    </div>
  )}
  {alt && <figcaption class="lbl">{alt}</figcaption>}
</figure>
